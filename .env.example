# =====================================================
# Telegram
# =====================================================
# 部署到 Railway 时，不要上传 .env，把这些填到 Railway Variables。
TG_BOT_TOKEN=123456:replace_me
TG_CHAT_ID=-1001234567890

# 改阈值的管理员 user_id 列表，逗号分隔。空 = 不限制（向后兼容）。
# 用 /whoami 命令可以查到自己的 user_id。
ALLOWED_USER_IDS=

# =====================================================
# Polymarket data API
# =====================================================
DATA_API_BASE=https://data-api.polymarket.com
GAMMA_API_BASE=https://gamma-api.polymarket.com

# 调用失败的最大重试次数（429/5xx/网络错误，指数退避 + jitter）
API_MAX_RETRIES=5
REQUEST_TIMEOUT_SEC=12

# =====================================================
# 阈值（USDC）。Telegram /menu 在线改会自动持久化覆盖此值。
# =====================================================
THRESHOLD_USDC=10000

# =====================================================
# 成交轮询
# =====================================================
# data-api 公共端点，3s 已经够实时；过快易触发 429
POLL_INTERVAL_SEC=3
TRADES_PAGE_SIZE=100
TRADES_MAX_PAGES=5

# 默认 false：刚启动只 seed，不补推历史，避免开机刷屏
ALERT_ON_STARTUP=false

# 防回放：成交时间距 now 超过 N 秒就丢弃。0 = 不过滤
MAX_ALERT_AGE_SEC=300

# =====================================================
# 状态持久化
# Railway 必须挂 Volume 到 /data，否则容器重启会丢这些文件
# =====================================================
SEEN_STATE_PATH=/data/polymarket_seen.json
RUNTIME_STATE_PATH=/data/runtime_state.json
MAX_SEEN_IDS=10000

# =====================================================
# 链接模板
# =====================================================
# 市场链接（{slug} / {event_slug} 占位符）
MARKET_URL_TEMPLATE=https://polymarket.com/market/{slug}
EVENT_URL_TEMPLATE=https://polymarket.com/event/{event_slug}
# 链上 tx（Polygon）
TX_URL_TEMPLATE=https://polygonscan.com/tx/{hash}
# 钱包链接（{address} / {username}）
USER_URL_TEMPLATE=https://polymarket.com/profile/{address}

# =====================================================
# 摘要
# =====================================================
# 自动摘要间隔（秒）。0 = 关闭，仍可 /summary 手动查
SUMMARY_INTERVAL_SEC=3600

# =====================================================
# 杂项
# =====================================================
# 默认语言：zh / en（运行期 /lang 可切）
LANG_BOT=zh
# 时间显示时区（IANA 名）
DISPLAY_TZ=Asia/Shanghai
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30
